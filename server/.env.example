# Copy to .env.development / .env.production (gitignored) and fill in.

# Shared secret for the developer build (client/.env.devtools) — grants
# devAdjustLevel / devResetLevel / devKick / devBan over the devToken a
# developer-build client sends on join. Leave unset to disable dev tools
# entirely; the server never allows them without an exact match.
DEV_SECRET=

# Optional: a Firebase service-account JSON (as a single-line string), used
# to verify player ID tokens and enforce /ban via Firestore `bans/{uid}`.
# Without this, joins are unauthenticated as they are today, and /ban will
# report that Firebase Admin isn't configured rather than silently no-op.
FIREBASE_SERVICE_ACCOUNT_JSON=
