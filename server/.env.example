# SERVER config. Copy to server/.env.development / .env.production
# (gitignored) and fill in. Loaded by server/src/loadEnv.js at startup;
# restart the server after changing it.

# Required for developer authentication. The server compares the devToken a
# developer-tools client sends on join against this value; only an exact
# match grants the dev commands (/ban, /unban, /givexp, /setxp,
# /togglefreezexp). The client's matching value goes in client/.env.devtools
# as VITE_DEV_SECRET. Leave unset to disable dev tools entirely. Never put
# this in a VITE_ variable.
DEV_SECRET=

# Optional: a Firebase service-account JSON (as a single-line string), used
# to verify player ID tokens and enforce /ban via Firestore `bans/{uid}`.
# Without this, joins are unauthenticated as they are today, and /ban will
# report that Firebase Admin isn't configured rather than silently no-op.
FIREBASE_SERVICE_ACCOUNT_JSON=
